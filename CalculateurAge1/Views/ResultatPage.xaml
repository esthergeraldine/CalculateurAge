<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge1.Views.ResultatPage"
             Title="Resultat">
    <VerticalStackLayout Padding="20" Spacing="16">
        <Label Text="{Binding Resultat}" FontSize="22"/>
        <Label Text="{Binding Message}" FontSize="18" TextColor="Green"/>
        <Label Text="{Binding Anniversaire}" FontSize="16"/>
        <Button Text="Retour" Clicked="OnRetourClicked"/>
    </VerticalStackLayout>
</ContentPage>